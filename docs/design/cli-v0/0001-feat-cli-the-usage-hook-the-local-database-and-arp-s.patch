+      server: 'github',
+      fn: 'create_issue',
+    });
+    expect(parseMcpToolName('mcp__plugin_acme_search__query')).toEqual({
+      server: 'plugin_acme_search',
+      fn: 'query',
+    });
+    expect(parseMcpToolName('mcp__a__b__c')).toEqual({ server: 'a', fn: 'b__c' });
