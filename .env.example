# Copy this file to .env and fill in the values. Never commit .env.
#
# Authoritative reference for chain values + external contract addresses:
#   deployments/13579.json
#
# Chain target: Intuition Testnet (chainId 13579) for the hackathon build.
# Mainnet is out of scope (see docs/00_HACKATHON_PIVOT.md).

# ---------- Foundry / contract deployments ----------

# Intuition Testnet RPC endpoint (read-only public, no API key).
INTUITION_TESTNET_RPC_URL=https://testnet.rpc.intuition.systems/http

# Deployer private key. Testnet-only — never use a key that holds mainnet value.
# Generate with: cast wallet new
# Fund the resulting address with tTRUST before running the deploy script.
PRIVATE_KEY=

# Foundry uses ETHERSCAN_API_KEY for contract verification. Intuition Testnet's
# explorer (https://testnet.explorer.intuition.systems) is Blockscout-style; it
# accepts an empty key for verification, but set one if the explorer team gave you
# one. Leave empty otherwise.
ETHERSCAN_API_KEY=

# ---------- Vite / app (VITE_ prefix exposes the var to client code) ----------

VITE_INTUITION_TESTNET_RPC_URL=https://testnet.rpc.intuition.systems/http
VITE_INTUITION_TESTNET_CHAIN_ID=13579
VITE_INTUITION_TESTNET_EXPLORER=https://testnet.explorer.intuition.systems
VITE_INTUITION_TESTNET_GRAPHQL=https://testnet.intuition.sh/v1/graphql

# WalletConnect cloud project ID — used by the Wagmi connector. Get one (free)
# from https://cloud.walletconnect.com.
VITE_WALLETCONNECT_PROJECT_ID=
