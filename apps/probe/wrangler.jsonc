{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arp-probe",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Local only for now (`bun run dev`). `wrangler dev` keeps this database on disk, so the id is a
  // placeholder until a real one is created for a deploy — which waits for the user.
  "d1_databases": [
    { "binding": "PROBES", "database_name": "arp-probe", "database_id": "arp-probe-local", "migrations_dir": "migrations" }
  ],
  // Every five minutes: ~20 targets, well under a Worker's subrequest ceiling.
  "triggers": { "crons": ["*/5 * * * *"] }
}
