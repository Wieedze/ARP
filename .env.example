# Copy this file to .env and fill in the values. Never commit .env.
#
# Authoritative reference for chain values + external contract addresses:
#   data/deployments/13579.json
#
# Chain target: Intuition Testnet (chainId 13579) for everything ARP deploys.
# One narrow exception: the trust panel reads Intuition Mainnet (1155) and can
# deposit real TRUST into vaults Intuition already owns there. Authorised by
# ADR 0017; it does not authorise deploying anything to mainnet.

# ---------- Foundry / contract deployments ----------

# Intuition Testnet RPC endpoint (read-only public, no API key).
INTUITION_TESTNET_RPC_URL=https://testnet.rpc.intuition.systems/http

# Deployer private key. Testnet-only — never use a key that holds mainnet value.
# Generate with: cast wallet new
# Fund the resulting address with tTRUST before running the deploy script.
PRIVATE_KEY=

# Agent EOA — a SEPARATE key from PRIVATE_KEY, used as the `delegate` in
# ERC-7710 delegations. The agent runs autonomously on the user's behalf,
# bounded by the deployed ARP enforcers. Generate with `cast wallet new`,
# fund the resulting address with ~0.1 tTRUST from the deployer wallet so
# it can pay gas when redeeming delegations.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Foundry uses ETHERSCAN_API_KEY for contract verification. Intuition Testnet's
# explorer (https://testnet.explorer.intuition.systems) is Blockscout-style; it
# accepts an empty key for verification, but set one if the explorer team gave you
# one. Leave empty otherwise.
ETHERSCAN_API_KEY=

# Intuition partner pinning API key. Required for every `pinThing` /
# `pinOrganization` write. As of 2026-09 the indexer GraphQL endpoints
# (testnet.intuition.sh, mainnet.intuition.sh) answer "no mutations exist" —
# pinning moved to the gated https://pin.intuition.systems/v1/graphql, which
# returns 401 without this key. The endpoint is network-agnostic: the same key
# serves testnet and mainnet.
#
# NEVER give this a VITE_ prefix. Vite inlines VITE_* vars into the client
# bundle, which would publish the partner key to every visitor. Intuition
# writes run server-side only (ADR 0016).
#
# Verify it with: bun run verify:pin
INTUITION_PIN_API_KEY=
# Optional. Defaults to "apikey". Set only if Intuition moves to another scheme
# (e.g. "Authorization" for a Bearer token).
INTUITION_PIN_API_KEY_HEADER=

# ---------- Vite / app (VITE_ prefix exposes the var to client code) ----------

VITE_INTUITION_TESTNET_RPC_URL=https://testnet.rpc.intuition.systems/http
VITE_INTUITION_TESTNET_CHAIN_ID=13579
VITE_INTUITION_TESTNET_EXPLORER=https://testnet.explorer.intuition.systems

# WalletConnect cloud project ID — used by the Wagmi connector. Get one (free)
# from https://cloud.walletconnect.com.
VITE_WALLETCONNECT_PROJECT_ID=

# ---------- Trust panel — Intuition Mainnet (ADR 0017) ----------

# The `/agents` and `/agent/:chainId/:tokenId` routes read Intuition Mainnet
# (chain 1155, MultiVault 0x6E35cF57A41fA15eA0EaE9C33e751b01A784Fe7e) no matter
# which chain the wallet is on, and the stake control deposits real TRUST there.
# The RPC and the MultiVault address are compiled in (app/src/lib/intuition-mainnet.ts)
# rather than env-driven: they are not deployment-dependent, and a typo in one of
# them is a lost transaction.

# Hard per-transaction ceiling for the stake control, in whole TRUST. Anything
# above it is refused in the UI before the wallet opens. Unset, zero, negative or
# unparseable all fall back to 1 TRUST — a typo must never remove the backstop.
VITE_MAX_STAKE_TRUST=1

# ARP's Worker (apps/api): GitHub's and skills.sh's figures, refreshed on a schedule.
# Local: `cd apps/api && bun run dev` serves it on http://localhost:8787. Unset, the app
# shows the dated copy bundled in apps/web/src/data/ instead.
VITE_ARP_API_URL=

# ---------------------------------------------------------------------------
# The domain index the MCP node reads (scripts/arp-mcp-server.ts)
#
# ARP's domain tree is the set of hierarchy and `has tag` triples one address
# holds a position on. `has tag` and the hierarchy are permissionless to WRITE
# — anybody can file anything under any domain for the price of one triple —
# so an index is a *reading* of those filings through one chosen set of
# positions. That reading is the safety net on classification, which is why it
# is configured on the node and is NOT a parameter an agent can pass.
#
# Leave this unset to read ARP's own index, which is the default compiled into
# the node. Set it to read somebody else's, or your own once you have filed
# domains yourself. Set it to an empty value to disable domain search — it then
# refuses, rather than falling back to the unfiltered graph.
#
# ARP_DOMAIN_ATTESTOR=

# ---------------------------------------------------------------------------
# GitHub, for the liveness connector (scripts/seed/record-maintained.ts)
#
# Optional. Without it GitHub allows 60 requests an hour and the catalogue is 53,
# so one run plus one measurement exhausts the quota. With it, 5,000.
#
# Use a CLASSIC token with NO SCOPES SELECTED. That grants public read and
# literally nothing else, so leaking it costs nothing. Never give this one repo,
# workflow or write access, and never prefix it with VITE_ — that would ship it
# to the browser.
#
# GITHUB_TOKEN=
